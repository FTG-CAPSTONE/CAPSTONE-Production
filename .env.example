# ── Application ───────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-dev-key-replace-before-any-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001
# 176.16.*.* IP range is handled by WildcardIPCORSMiddleware — no config needed

# ── Database ───────────────────────────────────────────────
# Project-specific credentials (created using postgres superuser)
DATABASE_URL=postgresql+psycopg2://claimguard:cg_secure_2026@127.0.0.1:5432/claimguard
ASYNC_DATABASE_URL=postgresql+asyncpg://claimguard:cg_secure_2026@127.0.0.1:5432/claimguard

# ── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Object Storage (MinIO / S3-compatible) ─────────────────
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=claimguard-docs
OBJECT_STORAGE_USE_SSL=false

# ── InsureMaster Integration ───────────────────────────────
INSUREMASTER_MODE=faker
INSUREMASTER_BASE_URL=
INSUREMASTER_API_KEY=

# ── Dev Seed Endpoint ──────────────────────────────────────
# MUST be false in any environment that touches real data
ENABLE_DEV_SEED_ENDPOINT=true

# ── Notifications ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@claimguard.co.ke

AT_API_KEY=changeme
AT_USERNAME=sandbox
AT_SENDER_ID=ClaimGuard

# ── Kafka (optional — Phase 2 production ingestion path) ───
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
