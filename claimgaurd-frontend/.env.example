# ClaimGuard Frontend — Environment Variables
# Copy these into Vercel: Project → Settings → Environment Variables
#
# NEXT_PUBLIC_ prefix means the value is exposed to the browser bundle.
# This is safe here — it's just the backend URL, not a secret.

# Your Render backend URL — no trailing slash
NEXT_PUBLIC_API_BASE_URL=https://claimguard-api.onrender.com
